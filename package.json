{
  "name": "silica",
  "version": "0.0.0",
  "description": "Web の画面の枠組み. 窓の管理, メニュー, 見た目を持ち, アプリを差し込んで使う",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamaoki-lab/silica.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./apps": {
      "source": "./src/apps/index.ts",
      "types": "./dist/apps/index.d.ts",
      "default": "./dist/apps/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./apps": {
        "types": "./dist/apps/index.d.ts",
        "default": "./dist/apps/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
