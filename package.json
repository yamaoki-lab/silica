{
  "name": "silica",
  "version": "0.0.0",
  "description": "Web の画面のフレームワーク. ウインドウの管理, メニュー, 見た目を持ち, アプリケーションを差し込んで使う",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamaoki-lab/silica.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.6.0",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/testdata",
    "!src/session/gen-json",
    "dist"
  ],
  "exports": {
    ".": {
      "silica-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./apps": {
      "silica-source": "./src/apps/index.ts",
      "types": "./dist/apps/index.d.ts",
      "default": "./src/apps/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "./apps": {
        "types": "./dist/apps/index.d.ts",
        "default": "./src/apps/index.ts"
      }
    }
  },
  "scripts": {
    "gen": "buf generate",
    "build:wasm": "node scripts/build-wasm.ts",
    "check:size": "node scripts/check-size.ts",
    "dev": "pnpm gen && pnpm --filter silica-example dev",
    "build": "pnpm gen && pnpm build:wasm && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "pnpm gen && tsc -b",
    "lint": "oxlint",
    "test": "pnpm gen && pnpm build:wasm && vitest run"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@types/node": "^26.6.3",
    "binaryen": "132.0.0",
    "oxlint": "^1.85.0",
    "ts-proto": "2.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  }
}
