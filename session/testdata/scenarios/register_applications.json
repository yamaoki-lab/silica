[
  {
    "name": "登録したアプリケーションを開ける",
    "steps": [
      {"request": {"registerApplications": {"applications": [{"id": "yamaoki.editor"}, {"id": "yamaoki.viewer-2", "singleInstance": true}]}}, "response": {"done": {}}},
      {"request": {"openApplication": {"applicationId": "yamaoki.editor"}}, "response": {"openApplicationResult": {"instanceId": 1}}, "events": [{"instanceCreated": {"instanceId": 1, "applicationId": "yamaoki.editor"}}]},
      {"request": {"openApplication": {"applicationId": "yamaoki.viewer-2"}}, "response": {"openApplicationResult": {"instanceId": 2}}, "events": [{"instanceCreated": {"instanceId": 2, "applicationId": "yamaoki.viewer-2"}}]}
    ]
  },
  {
    "name": "登録済みの id は重複として断る",
    "steps": [
      {"request": {"registerApplications": {"applications": [{"id": "yamaoki.editor"}]}}, "response": {"done": {}}},
      {"request": {"registerApplications": {"applications": [{"id": "yamaoki.editor"}]}}, "response": {"rejected": {"reason": "REJECT_REASON_DUPLICATE_APPLICATION"}}}
    ]
  },
  {
    "name": "1つでも重複があれば, どれも登録しない",
    "steps": [
      {"request": {"registerApplications": {"applications": [{"id": "yamaoki.viewer"}, {"id": "yamaoki.editor"}, {"id": "yamaoki.editor"}]}}, "response": {"rejected": {"reason": "REJECT_REASON_DUPLICATE_APPLICATION"}}},
      {"request": {"openApplication": {"applicationId": "yamaoki.viewer"}}, "response": {"rejected": {"reason": "REJECT_REASON_UNKNOWN_APPLICATION"}}}
    ]
  },
  {
    "name": "形の誤った id を断る",
    "steps": [
      {"request": {"registerApplications": {"applications": [{"id": "yamaoki.Editor"}]}}, "response": {"rejected": {"reason": "REJECT_REASON_INVALID_APPLICATION_ID"}}},
      {"request": {"registerApplications": {"applications": [{"id": "yamaoki.my_editor"}]}}, "response": {"rejected": {"reason": "REJECT_REASON_INVALID_APPLICATION_ID"}}},
      {"request": {"registerApplications": {"applications": [{"id": ""}]}}, "response": {"rejected": {"reason": "REJECT_REASON_INVALID_APPLICATION_ID"}}},
      {"request": {"registerApplications": {"applications": [{"id": "editor"}]}}, "response": {"rejected": {"reason": "REJECT_REASON_INVALID_APPLICATION_ID"}}},
      {"request": {"registerApplications": {"applications": [{"id": "yamaoki..editor"}]}}, "response": {"rejected": {"reason": "REJECT_REASON_INVALID_APPLICATION_ID"}}},
      {"request": {"registerApplications": {"applications": [{"id": "yamaoki."}]}}, "response": {"rejected": {"reason": "REJECT_REASON_INVALID_APPLICATION_ID"}}}
    ]
  }
]
