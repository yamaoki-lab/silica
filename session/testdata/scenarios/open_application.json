      {"request": {"openWindow": {"instanceId": 1, "title": "書類 1", "attributes": {}}}, "response": {"openWindowResult": {"windowId": 1}}, "events": [{"windowOpened": {"window": {"id": 1, "instanceId": 1, "title": "書類 1", "attributes": {}}}}, {"frontWindowChanged": {"windowId": 1}}]},
      {"request": {"openWindow": {"instanceId": 2, "title": "書類 2", "attributes": {}}}, "response": {"openWindowResult": {"windowId": 2}}, "events": [{"windowOpened": {"window": {"id": 2, "instanceId": 2, "title": "書類 2", "attributes": {}}}}, {"frontWindowChanged": {"windowId": 2}}]},
      {"request": {"bringWindowToFront": {"windowId": 1}}, "response": {"done": {}}, "events": [{"frontWindowChanged": {"windowId": 1}}]},
      {"request": {"openApplication": {"applicationId": "yamaoki.editor"}}, "response": {"openApplicationResult": {"instanceId": 1}}, "events": [{"forwardedToInstance": {"instanceId": 1}}]}
    ]
  },
