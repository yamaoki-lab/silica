      {"request": {"openApplication": {"applicationId": "yamaoki.editor"}}, "response": {"openApplicationResult": {"instanceId": 1}}, "events": [{"instanceCreated": {"instanceId": 1, "applicationId": "yamaoki.editor"}}]},
      {"request": {"openApplication": {"applicationId": "yamaoki.editor"}}, "response": {"openApplicationResult": {"instanceId": 1}}, "events": [{"forwardedToInstance": {"instanceId": 1}}]}
    ]
  },
  {
    "name": "新しく起動する時は, 実行中のインスタンスがあっても作る",
    "steps": [
      {"request": {"registerApplications": {"applications": [{"id": "yamaoki.editor"}]}}, "response": {"done": {}}},
      {"request": {"openApplication": {"applicationId": "yamaoki.editor"}}, "response": {"openApplicationResult": {"instanceId": 1}}, "events": [{"instanceCreated": {"instanceId": 1, "applicationId": "yamaoki.editor"}}]},
      {"request": {"openApplication": {"applicationId": "yamaoki.editor", "newInstance": true}}, "response": {"openApplicationResult": {"instanceId": 2}}, "events": [{"instanceCreated": {"instanceId": 2, "applicationId": "yamaoki.editor"}}]}
    ]
  },
  {
    "name": "単一インスタンスのアプリケーションは, 新しく起動する時も渡す",
