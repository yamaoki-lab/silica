      {"request": {"openApplication": {"applicationId": "yamaoki.editor"}}, "response": {"openApplicationResult": {"instanceId": 1}}, "events": [{"instanceCreated": {"instanceId": 1, "applicationId": "yamaoki.editor"}}]}
    ]
  },
  {
