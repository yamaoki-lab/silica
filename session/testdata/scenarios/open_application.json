      {"request": {"openApplication": {"applicationId": "yamaoki.editor"}}, "response": {"openApplicationResult": {"instanceId": 1}}, "events": [{"instanceCreated": {"instanceId": 1, "applicationId": "yamaoki.editor"}}]},
      {"request": {"openApplication": {"applicationId": "yamaoki.editor", "newInstance": true}}, "response": {"openApplicationResult": {"instanceId": 1}}, "events": [{"forwardedToInstance": {"instanceId": 1}}]}
    ]
  },
  {
    "name": "渡す先は, 最後に前面になったウインドウのインスタンス",
    "steps": [
      {"request": {"registerApplications": {"applications": [{"id": "yamaoki.editor"}]}}, "response": {"done": {}}},
      {"request": {"openApplication": {"applicationId": "yamaoki.editor"}}, "response": {"openApplicationResult": {"instanceId": 1}}, "events": [{"instanceCreated": {"instanceId": 1, "applicationId": "yamaoki.editor"}}]},
